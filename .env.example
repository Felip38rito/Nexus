# model-router environment (copy to .env)
# Upstream Ollama Cloud key — required to reach https://ollama.com/v1
OLLAMA_API_KEY=your_key_here

# Optional overrides
# OLLAMA_BASE_URL=https://ollama.com/v1
# ROUTER_HOST=127.0.0.1
# ROUTER_PORT=8000
# ROUTER_DEFAULT_TIER=air
# ROUTER_MIN_CLASSIFY_LEN=20
# ROUTER_API_KEY=  # optional bearer token clients must send to reach the router
# ROUTER_MODELS_YAML=  # optional path to a custom models YAML (default: router.models.yaml)
